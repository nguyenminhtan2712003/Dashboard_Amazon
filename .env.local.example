# =============================================================================
# Server-side env vars (NOT exposed to the browser — no NEXT_PUBLIC_ prefix).
# =============================================================================
# Your FastAPI deployment (the server/ folder).
FASTAPI_URL=http://localhost:8000
FASTAPI_KEY=change-me-to-match-server-.env

# How long Next.js caches the FastAPI snapshot before re-fetching (seconds).
# 300 = 5 min. Set to 0 to disable caching (every request hits FastAPI).
SNAPSHOT_REVALIDATE=300
